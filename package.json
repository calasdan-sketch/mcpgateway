{
  "name": "mcpgateway",
  "version": "0.3.0",
  "description": "Production MCP gateway: unified tool namespace, fleet-wide policy, per-tool rate limits, centralized audit log, Prometheus metrics, auth at the edge.",
  "author": "Calas Automations Inc.",
  "license": "MIT",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "gateway",
    "proxy",
    "policy",
    "audit",
    "rate-limit",
    "security"
  ],
  "type": "module",
  "bin": {
    "mcpgateway": "./dist/src/index.js"
  },
  "files": [
    "dist/src/**/*.js",
    "dist/src/**/*.d.ts",
    "mcpgateway.example.yaml",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "lint": "tsc --noEmit",
    "prepack": "npm run build",
    "bench": "npm run build && node bench/run.mjs",
    "test": "npm run build && node --test dist/tests/*.test.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.17.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "typescript": "5.9.2"
  }
}
